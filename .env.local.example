# Copie este arquivo para .env.local (mesma pasta) e preencha com os valores reais.
# .env.local nunca deve ser commitado — o .gitignore do projeto já ignora esse nome.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Privileged secret key (same page, "service_role") — server-only, NEVER
# prefix with NEXT_PUBLIC_. Used only to create new admin accounts from
# inside /admin/usuarios.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase > Project Settings > Database > Connection string
# "Transaction" pooler (porta 6543) — usada em runtime pela aplicação
DATABASE_URL=
# "Session" (porta 5432, MESMO host do pooler acima) — usada só pelas
# migrações do drizzle-kit. NÃO use o host "db.<ref>.supabase.co" direto:
# esse só resolve em IPv6 e falha (ENOTFOUND) em rede só-IPv4.
DATABASE_URL_DIRECT=

# developers.mercadopago.com > sua aplicação > Credenciais de teste (sandbox)
MERCADOPAGO_ACCESS_TOKEN=
# developers.mercadopago.com > sua aplicação > Notificações > Assinatura secreta
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do site (sem barra no final) — usada nos links de retorno do
# Mercado Pago e na notification_url do webhook
NEXT_PUBLIC_SITE_URL=http://localhost:3000
